# ==========================================================
# Global High-Ticket DTC Store - Environment Configuration
# Copy this file to .env.local and fill in your live/test keys
# ==========================================================

# 1. Store Public URL (used for Stripe Checkout redirects & SEO Sitemap/Feed)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Stripe Payment Gateway (Supports Cards, Apple Pay, Google Pay, Klarna, Affirm)
# Apply via US LLC (Stripe Atlas / Firstbase) or HK Company
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# 3. PayPal Express Checkout (Optional secondary gateway for EU/US buyers)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# 4. Supabase Database (Optional persistent storage for Products & Orders)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 5. Analytics & Ad Pixels (Meta Pixel, TikTok Pixel, Google Ads GTAG)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX
